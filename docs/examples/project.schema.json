{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 170
    },
    "brief": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "poems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          },
          "form": {
            "enum": [
              "free",
              "declared"
            ]
          },
          "profile_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "intent": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "order",
          "form",
          "profile_id",
          "intent"
        ]
      },
      "maxItems": 80
    },
    "stanzas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "poem_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "poem_id",
          "title",
          "order"
        ]
      },
      "maxItems": 200
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "stanza_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "reading": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tone": {
                  "enum": [
                    "P",
                    "Z",
                    "?"
                  ]
                },
                "rhyme_key": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "position",
                "unit",
                "reading",
                "tone",
                "rhyme_key"
              ]
            },
            "maxItems": 2000
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "byte_start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "byte_end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000000
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              },
              "required": [
                "source_index",
                "byte_start",
                "byte_end",
                "quote"
              ]
            },
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "stanza_id",
          "order",
          "text",
          "readings",
          "ranges"
        ]
      },
      "maxItems": 600
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "line_no": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "units": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 300
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tones": {
                  "type": "string",
                  "pattern": "^[PZ*]{0,300}$"
                },
                "rhyme_group": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "line_no",
                "units",
                "tones",
                "rhyme_group"
              ]
            },
            "maxItems": 600
          }
        },
        "required": [
          "id",
          "title",
          "system",
          "source_note",
          "rules"
        ]
      },
      "maxItems": 40
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "line_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "line_id",
          "line_sha256",
          "text",
          "rationale"
        ]
      },
      "maxItems": 300
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_kind": {
            "enum": [
              "line",
              "poem"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "author",
              "agent"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "target_kind",
          "target_id",
          "target_sha256",
          "origin",
          "comment",
          "status",
          "resolution"
        ]
      },
      "maxItems": 300
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "poem_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "source_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "poem_id",
          "source_index",
          "source_text",
          "sha256"
        ]
      },
      "maxItems": 40
    },
    "basis_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_plugin_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "owner_plugin_id",
          "object_id",
          "revision",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "title",
    "brief",
    "poems",
    "stanzas",
    "lines",
    "profiles",
    "variants",
    "notes",
    "imports",
    "basis_refs"
  ]
}
